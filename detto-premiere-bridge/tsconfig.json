{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2022", "DOM"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["types/**/*.d.ts", "tools/roteiro/**/*.js", "plugin/src/core/**/*.js", "plugin/src/host/**/*.js"]
}
